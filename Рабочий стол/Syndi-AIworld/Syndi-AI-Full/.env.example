# 🔮 Syndi-AI Configuration
# Скопируйте этот файл в .env и заполните своими значениями

# ======================
# Обязательные переменные
# ======================

# Telegram Bot Token (получить у @BotFather)
# Нужен для работы Telegram бота
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ID администратора в Telegram (узнать у @userinfobot)
ADMIN_ID=your_telegram_id_here

# DeepSeek API Key (https://platform.deepseek.com/)
# Нужен для работы AI-агентов
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ======================
# Опциональные переменные
# ======================

# IONQ API Key для квантовых вычислений (https://ionq.com/)
# Опционально - без него будут использоваться симуляции
IONQ_API_KEY=your_ionq_api_key_here

# Использовать реальные квантовые вычисления (True/False)
# Если False - используются симуляции
USE_REAL_QUANTUM=False

# Режим отладки (True/False)
DEBUG=False

# ======================
# Database (для будущей интеграции)
# ======================
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/syndi
