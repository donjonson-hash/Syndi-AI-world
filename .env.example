# ============================================================
# Syndi-AI — переменные окружения
# Скопируй в .env и заполни реальными значениями
# ============================================================

# ── База данных ─────────────────────────────────────────────
POSTGRES_PASSWORD=syndi_secure_password_here
DATABASE_URL=postgresql+asyncpg://syndi:syndi_secure_password_here@postgres:5432/syndi_db

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant ──────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── AI API ключи ────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
MIMO_API_KEY=

# ── Embed модель (лёгкая, ~470 MB) ──────────────────────────
EMBED_MODEL_RU=paraphrase-multilingual-MiniLM-L12-v2

# ── Приложение ──────────────────────────────────────────────
SECRET_KEY=замени-это-на-случайную-строку-минимум-32-символа
CORS_ORIGINS=http://195.245.112.66,https://yourdomain.com

# ── Telegram бот (если есть) ────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── GitHub (для агента) ──────────────────────────────────────
GITHUB_TOKEN=
