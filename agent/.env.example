# Скопируй этот файл в .env и заполни своими ключами
# cp .env.example .env

# DeepSeek API key — получить на https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token — получить на https://github.com/settings/tokens
# Нужные права: repo (read/write), workflow
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Репозиторий проекта
GITHUB_REPO=donjonson-hash/Syndi-AI-world
