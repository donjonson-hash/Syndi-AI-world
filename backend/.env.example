# Syndi Tinder co-founder — environment variables
# Скопируй в .env и заполни значения

# База данных (production — PostgreSQL, для тестов SQLite in-memory)
DATABASE_URL=postgresql+asyncpg://syndi:syndi@localhost:5432/syndi_db
# DATABASE_URL=sqlite+aiosqlite:///./syndi_local.db   # локальная разработка

# Redis (кэш discover feed, avatar state, rate limiting)
REDIS_URL=redis://localhost:6379/0

# Security — JWT signing key (в проде ОБЯЗАТЕЛЬНО заменить)
SECRET_KEY=syndi-secret-key-change-in-prod

# OpenAI (только если используются реальные LLM-агенты, не Mock)
OPENAI_API_KEY=sk-...

# Mimo AI (LLM для Kristina-агента, OpenAI-совместимый API)
MIMO_API_KEY=sk-...
MIMO_BASE_URL=https://api.mimo.team/v1
MIMO_MODEL=mimo-v2.5-pro

# Telegram Bot (опционально)
TELEGRAM_BOT_TOKEN=...

# Окружение
ENV=development
