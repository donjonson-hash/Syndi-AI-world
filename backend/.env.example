# Syndi Tinder co-founder — environment variables
# Скопируй в .env и заполни значения

# База данных (production — PostgreSQL, для тестов SQLite in-memory)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/syndi_db
# DATABASE_URL=sqlite+aiosqlite:///./syndi_local.db   # локальная разработка

# OpenAI (только если используются реальные LLM-агенты, не Mock)
OPENAI_API_KEY=sk-...

# Telegram Bot (опционально)
TELEGRAM_BOT_TOKEN=...

# Окружение
ENV=development
